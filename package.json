{
  "name": "brief",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "vp check",
    "test": "vitest run",
    "test:watch": "vitest",
    "fallow:check": "fallow dead-code && fallow dupes",
    "fallow": "fallow audit --coverage coverage/coverage-final.json && fallow health --coverage coverage/coverage-final.json && fallow health --coverage coverage/coverage-final.json --min-score 100",
    "verify": "pnpm typecheck && pnpm lint && pnpm test --coverage && pnpm fallow:check"
  },
  "dependencies": {
    "@takumi-rs/helpers": "^2.22.1",
    "idb-keyval": "^6.2.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "takumi-pdf": "^0.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.8",
    "fallow": "^3.49.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vite-plus": "^1.8.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0"
}
